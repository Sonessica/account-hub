# Account Hub runtime configuration
# Copy to .env next to docker-compose.yml (never commit .env)

# Admin password for /bento/editor gate (required, min 6 chars)
ACCOUNT_HUB_ADMIN_PASSWORD=

# HMAC secret for session cookies (required, min 32 chars)
ACCOUNT_HUB_SESSION_SECRET=

# SQLite file path (optional)
# Docker default: /app/data/account-hub.sqlite
# Local example: ./data/account-hub.sqlite
# ACCOUNT_HUB_DB_PATH=/app/data/account-hub.sqlite

# Public origin used for same-origin checks.
# Must match the browser address exactly (scheme + host + port).
NEXT_PUBLIC_APP_URL=https://account.atchooo.com:2096

# --- Legacy OpenBento / Supabase (not used by the single-user editor) ---
# NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
