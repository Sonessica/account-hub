generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Platform {
  id                        String    @id @default(cuid())
  key                       String    @unique
  name                      String
  category                  String
  color                     String
  defaultLoginUrl           String?
  defaultManageUrl          String?
  defaultProfileUrlTemplate String?
  accounts                  Account[]
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
}

model Account {
  id             String       @id @default(cuid())
  platformId     String
  platform       Platform     @relation(fields: [platformId], references: [id])
  displayName    String
  username       String?
  platformUserId String?
  avatarUrl      String?
  bio            String?
  email          String?
  phone          String?
  profileUrl     String?
  loginUrl       String?
  managementUrl  String?
  vaultItemHint  String?
  notes          String?
  favorite       Boolean      @default(false)
  pinned         Boolean      @default(false)
  bentoSize      String       @default("standard")
  priority       Int          @default(0)
  sortOrder      Int          @default(0)
  tags           AccountTag[]
  auditLogs      AuditLog[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([platformId])
  @@index([pinned, sortOrder, priority])
  @@index([favorite, sortOrder])
}

model Tag {
  id        String       @id @default(cuid())
  name      String       @unique
  accounts  AccountTag[]
  createdAt DateTime     @default(now())
}

model AccountTag {
  accountId String
  tagId     String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([accountId, tagId])
  @@index([tagId])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([accountId])
}
